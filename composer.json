{
    "name": "adiachenko/knotbane",
    "description": "Find cyclomatic complexity hotspots in targeted PHP code",
    "type": "library",
    "authors": [
        {
            "name": "Alexander Diachenko"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sebastian/complexity": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Knotbane\\": "src/"
        }
    },
    "bin": [
        "bin/knotbane"
    ],
    "scripts": {
        "test": "pest --compact --parallel",
        "format": "pint --parallel",
        "format:check": "pint --test --parallel"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
